generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  passwordHash        String
  role                Role
  status              UserStatus         @default(ACTIVE)
  failedLoginAttempts Int                @default(0)
  lastFailedLoginAt   DateTime?
  lockUntil           DateTime?
  canOverrideCapacity Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  adminProfile        AdminProfile?
  approvals           Approval[]         @relation("ApprovedBy")
  enrollments         Enrollment[]       @relation("StudentEnrollments")
  financeLedgers      FinanceLedger[]    @relation("StudentFinanceLedgers")
  notifications       Notification[]
  passwordResetOtps   PasswordResetOtp[]
  studentProfile      StudentProfile?
  waitingEntries      WaitingEntry[]     @relation("StudentWaitingEntries")
}

model StudentProfile {
  userId                  String    @id
  studentCode             String    @unique
  fullName                String
  faculty                 String?
  phoneNumber             String?
  dateOfBirth             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  waitingRoomBlockedUntil DateTime?
  priorityPenaltyUntil    DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  userId     String   @id
  fullName   String
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  credits     Int
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  planType    CoursePlanType  @default(IN_PLAN)
  faculty     String          @default("Chưa phân ngành")
  enrollments Enrollment[]
  financeRows FinanceLedger[]
  sections    Section[]
  waitingRoom WaitingRoom?

  @@index([faculty, planType, isActive])
}

model Room {
  id        String    @id @default(cuid())
  code      String    @unique
  building  String
  capacity  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  campus    String?
  address   String?
  sections  Section[]
}

model TimeSlot {
  id        String    @id @default(cuid())
  label     String    @unique
  startTime String
  endTime   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sections  Section[]
}

model Section {
  id              String          @id @default(cuid())
  code            String          @unique
  courseId        String
  roomId          String
  dayOfWeek       DayOfWeek
  timeSlotId      String
  startDate       DateTime?
  endDate         DateTime?
  capacity        Int
  capacityHidden  Boolean         @default(false)
  registeredCount Int             @default(0)
  reservedCount   Int             @default(0)
  status          SectionStatus   @default(OPEN)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  isWaitingOption Boolean         @default(false)
  enrollments     Enrollment[]
  financeRows     FinanceLedger[]
  course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  room            Room            @relation(fields: [roomId], references: [id])
  timeSlot        TimeSlot        @relation(fields: [timeSlotId], references: [id])
  offeredEntries  WaitingEntry[]  @relation("OfferSection")

  @@index([courseId, status])
  @@index([dayOfWeek, timeSlotId])
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  courseId  String
  sectionId String
  status    EnrollmentStatus @default(ENROLLED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section   Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student   User             @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sectionId])
  @@index([studentId, status])
  @@index([studentId, courseId, status])
}

model WaitingRoom {
  id          String         @id @default(cuid())
  courseId    String         @unique
  isActive    Boolean        @default(false)
  activatedAt DateTime?
  buffer      Int            @default(5)
  slaHours    Int            @default(48)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  approvals   Approval[]
  entries     WaitingEntry[]
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model WaitingEntry {
  id              String            @id @default(cuid())
  waitingRoomId   String
  studentId       String
  joinedAt        DateTime          @default(now())
  prioritiesJson  Json
  state           WaitingEntryState @default(QUEUED)
  offerSectionId  String?
  expiresAt       DateTime?
  reason          String?
  lastNotifiedAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  termsAcceptedAt DateTime?
  matchedPriority Int?
  offerSection    Section?          @relation("OfferSection", fields: [offerSectionId], references: [id])
  student         User              @relation("StudentWaitingEntries", fields: [studentId], references: [id], onDelete: Cascade)
  waitingRoom     WaitingRoom       @relation(fields: [waitingRoomId], references: [id], onDelete: Cascade)

  @@index([waitingRoomId, state, joinedAt])
  @@index([studentId, state])
}

model Approval {
  id            String         @id @default(cuid())
  waitingRoomId String
  status        ApprovalStatus @default(PENDING)
  reason        String?
  approvedById  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  dueAt         DateTime
  approvedBy    User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  waitingRoom   WaitingRoom    @relation(fields: [waitingRoomId], references: [id], onDelete: Cascade)

  @@index([waitingRoomId, status, dueAt])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  payloadJson Json
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model FinanceLedger {
  id        String        @id @default(cuid())
  studentId String
  courseId  String?
  sectionId String?
  amount    Decimal       @db.Decimal(12, 2)
  status    FinanceStatus @default(POSTED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  course    Course?       @relation(fields: [courseId], references: [id])
  section   Section?      @relation(fields: [sectionId], references: [id])
  student   User          @relation("StudentFinanceLedgers", fields: [studentId], references: [id], onDelete: Cascade)
}

model PasswordResetOtp {
  id           String    @id @default(cuid())
  userId       String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  lastSentAt   DateTime
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum SectionStatus {
  OPEN
  CLOSED
}

enum EnrollmentStatus {
  ENROLLED
  CANCELLED
}

enum WaitingEntryState {
  QUEUED
  OFFERED
  CONFIRMED
  DECLINED
  EXPIRED
  FAILED
  DEFERRED
  PENDING_ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
}

enum NotificationType {
  WAITING_OFFER
  WAITING_REJECTED
  WAITING_EXPIRED
  SYSTEM
}

enum FinanceStatus {
  PENDING
  POSTED
  VOID
}

enum CoursePlanType {
  IN_PLAN
  OUT_PLAN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
